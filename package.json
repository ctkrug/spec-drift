{
  "name": "spec-drift",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based OpenAPI breaking-change detector: paste two specs, get a plain-English report of what breaks your clients.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctkrug/spec-drift.git"
  },
  "homepage": "https://github.com/ctkrug/spec-drift",
  "bugs": "https://github.com/ctkrug/spec-drift/issues",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
